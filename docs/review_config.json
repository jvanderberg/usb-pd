{
 "_comment": "Review config for the usbpd board (kicad-board-review). Currents: 5 A output (100 W at 20 V); 5 V rail ~35 mA peak (requirements power budget). Enclosure: user's 3D-printed case.",
 "ground_nets": [
  "GND"
 ],
 "net_classes": [
  {
   "match": "^/USB_D[PM]$",
   "class": "usb"
  },
  {
   "match": "^/(SDA|SCL)$",
   "class": "i2c"
  },
  {
   "match": "^Net-\\(J1-CC[12]\\)$",
   "class": "slow_ext"
  },
  {
   "match": "^Net-\\(J3-",
   "class": "slow_ext"
  },
  {
   "match": "^(VBUS|/VOUT|/VOUT_SW|\\+5V|\\+3V3|Net-\\(U4-V33\\))$",
   "class": "power"
  }
 ],
 "fast_classes": [
  "usb"
 ],
 "diff_pairs": [
  {
   "nets": [
    "/USB_DP",
    "/USB_DM"
   ],
   "target_ohm": 90
  }
 ],
 "rail_voltages": {
  "VBUS": 20,
  "/VOUT": 20,
  "/VOUT_SW": 20
 },
 "hot_loops": [],
 "power_runs": [
  {
   "name": "vbus",
   "net": "VBUS",
   "title": "J1 VBUS pins to Q1 source pins, 5 A",
   "source": [
    "J1:A4B9",
    "J1:B4A9"
   ],
   "sinks": [
    [
     "Q1:1",
     1.667
    ],
    [
     "Q1:2",
     1.667
    ],
    [
     "Q1:3",
     1.666
    ]
   ]
  },
  {
   "name": "vout_sw",
   "net": "/VOUT_SW",
   "title": "Q1 drains to shunt R10 pad 1, 5 A",
   "source": [
    "Q1:5",
    "Q1:6",
    "Q1:7",
    "Q1:8"
   ],
   "sinks": [
    [
     "R10:1",
     5.0
    ]
   ]
  },
  {
   "name": "vout",
   "net": "/VOUT",
   "title": "Shunt R10 pad 2 to J2 pin 1, 5 A",
   "source": [
    "R10:2"
   ],
   "sinks": [
    [
     "J2:1",
     5.0
    ]
   ]
  },
  {
   "name": "gnd_return",
   "net": "GND",
   "title": "Load return J2 pin 2 to the USB-C ground pins, 5 A",
   "source": [
    "J1:A1B12",
    "J1:B1A12"
   ],
   "sinks": [
    [
     "J2:2",
     -5.0
    ]
   ]
  }
 ],
 "thermal": {
  "ambient_C": 35,
  "h_W_m2K": "enclosed",
  "board_T_max_C": 105,
  "corners": {
   "20V_5A": {
    "title": "20 V PD contract, 5 A load (100 W), Q1 Vgs about -18 V",
    "currents": {
     "I_out": 5.0
    }
   },
   "9V_5A": {
    "title": "9 V, 5 A (worst Q1 loss at lower gate drive, Vgs about -8 V)",
    "currents": {
     "I_out": 5.0
    }
   },
   "5V_3A": {
    "title": "5 V, 3 A (Vgs about -4.5 V)",
    "currents": {
     "I_out": 3.0
    }
   }
  },
  "sources": [
   {
    "ref": "Q1",
    "what": "output PMOS",
    "kind": "i2r",
    "R_ohm": {
     "20V_5A": 0.0161,
     "9V_5A": 0.0185,
     "5V_3A": 0.0259
    },
    "I": "I_out",
    "basis": "AO4407A (UMW) DS RDS(on) max 11.5 mOhm @ -10 V, 18.5 mOhm @ -4.5 V, x1.4 hot (Fig. 4); 9 V corner uses the -4.5 V value"
   },
   {
    "ref": "R10",
    "what": "5 mOhm shunt",
    "kind": "i2r",
    "R_ohm": 0.005,
    "I": "I_out",
    "basis": "RLM12FTCMR005"
   },
   {
    "ref": "J1",
    "what": "USB-C VBUS + GND contacts",
    "kind": "i2r",
    "R_ohm": 0.02,
    "I": "I_out",
    "basis": "USB Type-C spec LLCR 40 mOhm max per contact (initial), 4 VBUS + 4 GND contacts in parallel = 10 + 10 mOhm; no figure in the TYPE-C-31-M-12 datasheet. Worst case; typical is several times lower"
   },
   {
    "ref": "J2",
    "what": "screw terminal, both poles",
    "kind": "i2r",
    "R_ohm": 0.004,
    "I": "I_out",
    "basis": "ASSUMED ~2 mOhm per pole (no datasheet figure for the generic MKDS-1,5 footprint part)"
   },
   {
    "copper_run": "vbus",
    "I": "I_out",
    "group": "power path"
   },
   {
    "copper_run": "vout_sw",
    "I": "I_out",
    "group": "power path"
   },
   {
    "copper_run": "vout",
    "I": "I_out",
    "group": "power path"
   },
   {
    "copper_run": "gnd_return",
    "I": "I_out",
    "group": "power path"
   },
   {
    "ref": "U2",
    "what": "5 V LDO from VBUS",
    "kind": "fixed",
    "P_W": {
     "20V_5A": 0.53,
     "9V_5A": 0.14,
     "5V_3A": 0.0
    },
    "basis": "(Vin - 5 V) x 35 mA peak 5 V rail (requirements power budget); 5 V in: dropout, ~0"
   },
   {
    "ref": "U3",
    "what": "3.3 V LDO",
    "kind": "fixed",
    "P_W": 0.05,
    "basis": "(5 - 3.3) V x 27 mA (OLED + I2C + INA226)"
   },
   {
    "ref": "U1",
    "kind": "negligible",
    "why": "HUSB238, a few mA"
   },
   {
    "ref": "U4",
    "kind": "negligible",
    "why": "CH552, 6-11 mA at 5 V (0.05 W)"
   },
   {
    "ref": "U5",
    "kind": "negligible",
    "why": "INA226, 0.4 mA"
   },
   {
    "ref": "Q2",
    "kind": "negligible",
    "why": "2N7002 gate driver, 0.2 mA"
   },
   {
    "ref": "D1",
    "kind": "negligible",
    "why": "BAT54, bootloader-entry pull-up only"
   }
  ],
  "parts": {
   "Q1": {
    "psi_jb": 24.0,
    "Tj_max_C": 150,
    "basis": "AO4407A DS RthJL max 24 C/W (junction-to-lead) used as psi_JB"
   },
   "U2": {
    "psi_jb": null,
    "theta_jc": null,
    "Tj_max_C": 125,
    "basis": "SGM2203 DS gives only theta_JA 65 C/W (SOT-89-3)"
   },
   "U5": {
    "psi_jb": 80.4,
    "Tj_max_C": 150,
    "basis": "INA226 DS RthJB 80.4 C/W"
   }
  },
  "pads": {}
 }
}
