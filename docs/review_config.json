{
 "_comment": "Review config for the USB-PD PPS board (kicad-board-review). 5 A max output, 21 V max (PPS clamp); 5 V rail ~35 mA peak. Enclosure: 3D-printed case.",
 "ground_nets": [
  "GND"
 ],
 "net_classes": [
  {
   "match": "^/USB_D[PM]$",
   "class": "usb"
  },
  {
   "match": "^/(SDA|SCL|SDA5|SCL5)$",
   "class": "i2c"
  },
  {
   "match": "^Net-\\(U4-P1\\.[67]\\)$",
   "class": "i2c"
  },
  {
   "match": "^/CC[12]$",
   "class": "slow_ext"
  },
  {
   "match": "^Net-\\(J3-",
   "class": "slow_ext"
  },
  {
   "match": "^/(VOUT_MON|PWR_EN)$|^Net-\\(U1-(OTP|IFB)\\)$",
   "class": "analog"
  },
  {
   "match": "^(VBUS|/VBUS_S|/OUT|\\+5V|\\+3V3|Net-\\(U4-V33\\)|Net-\\(U1-V5V\\)|Net-\\(U1-V18\\))$",
   "class": "power"
  }
 ],
 "fast_classes": [
  "usb"
 ],
 "diff_pairs": [
  {
   "nets": [
    "/USB_DP",
    "/USB_DM"
   ],
   "target_ohm": 90
  }
 ],
 "rail_voltages": {
  "VBUS": 21,
  "/VBUS_S": 21,
  "/OUT": 21
 },
 "hot_loops": [],
 "power_runs": [
  {
   "name": "vbus",
   "net": "VBUS",
   "title": "J1 VBUS pins to shunt R10 pad 1, 5 A",
   "source": [
    "J1:A4B9",
    "J1:B4A9"
   ],
   "sinks": [
    [
     "R10:1",
     5.0
    ]
   ]
  },
  {
   "name": "vbus_s",
   "net": "/VBUS_S",
   "title": "Shunt R10 pad 2 to Q1 drain, 5 A",
   "source": [
    "R10:2"
   ],
   "sinks": [
    [
     "Q1:5",
     5.0
    ]
   ]
  },
  {
   "name": "out",
   "net": "/OUT",
   "title": "Q1 sources to J2 pin 1, 5 A",
   "source": [
    "Q1:1",
    "Q1:2",
    "Q1:3"
   ],
   "sinks": [
    [
     "J2:1",
     5.0
    ]
   ]
  },
  {
   "name": "gnd_return",
   "net": "GND",
   "title": "Load return J2 pin 2 to the USB-C ground pins, 5 A",
   "source": [
    "J1:A1B12",
    "J1:B1A12"
   ],
   "sinks": [
    [
     "J2:2",
     -5.0
    ]
   ]
  }
 ],
 "thermal": {
  "ambient_C": 35,
  "h_W_m2K": "enclosed",
  "board_T_max_C": 105,
  "corners": {
   "21V_5A": {
    "title": "21 V PPS / 20 V fixed, 5 A load; LDO at its worst (21 V in)",
    "currents": {
     "I_out": 5.0
    }
   },
   "5V_5A": {
    "title": "5 V PPS, 5 A (lowest gate drive if the charge pump tracks VOUT); LDO in dropout",
    "currents": {
     "I_out": 5.0
    }
   }
  },
  "sources": [
   {
    "ref": "Q1",
    "what": "output NMOS",
    "kind": "i2r",
    "R_ohm": 0.02,
    "I": "I_out",
    "basis": "AON7262E at the AP33772S gate drive: PWR_EN is at most VCC + 4 V (AP33772S DS abs max), so VGS < 4 V; DS Fig. 5 at 125 C gives ~10.5-13 mOhm typical, ~20 mOhm for a high-threshold part (design-review M1). Measure at bring-up"
   },
   {
    "ref": "R10",
    "what": "5 mOhm shunt",
    "kind": "i2r",
    "R_ohm": 0.005,
    "I": "I_out",
    "basis": "RLM12FTCMR005"
   },
   {
    "ref": "J1",
    "what": "USB-C VBUS + GND contacts",
    "kind": "i2r",
    "R_ohm": 0.02,
    "I": "I_out",
    "basis": "Type-C LLCR 40 mOhm max per contact, 4 + 4 contacts in parallel"
   },
   {
    "ref": "J2",
    "what": "screw terminal, both poles",
    "kind": "i2r",
    "R_ohm": 0.004,
    "I": "I_out",
    "basis": "ASSUMED ~2 mOhm per pole"
   },
   {
    "copper_run": "vbus",
    "I": "I_out",
    "group": "power path"
   },
   {
    "copper_run": "vbus_s",
    "I": "I_out",
    "group": "power path"
   },
   {
    "copper_run": "out",
    "I": "I_out",
    "group": "power path"
   },
   {
    "copper_run": "gnd_return",
    "I": "I_out",
    "group": "power path"
   },
   {
    "ref": "U2",
    "what": "5 V LDO from VBUS_S",
    "kind": "fixed",
    "P_W": {
     "21V_5A": 0.56,
     "5V_5A": 0.0
    },
    "basis": "(21 - 5) V x 35 mA peak 5 V rail (requirements power budget)"
   },
   {
    "ref": "U3",
    "what": "3.3 V LDO",
    "kind": "fixed",
    "P_W": 0.04,
    "basis": "(5 - 3.3) V x ~25 mA (OLED + MCU I/O)"
   },
   {
    "ref": "U1",
    "kind": "negligible",
    "why": "AP33772S, a few mA from VBUS"
   },
   {
    "ref": "U4",
    "kind": "negligible",
    "why": "CH552, 6-11 mA at 5 V (0.05 W)"
   },
   {
    "ref": "D1",
    "kind": "negligible",
    "why": "BAT54, bootloader-entry pull-up only"
   },
   {
    "ref": "RT1",
    "kind": "negligible",
    "why": "NTC, 100 uA from the AP33772S OTP pin"
   }
  ],
  "parts": {
   "Q1": {
    "psi_jb": 2.9,
    "Tj_max_C": 150,
    "basis": "AON7262E DS RthJC max 2.9 C/W (case = drain pad, soldered to the board)"
   },
   "U2": {
    "psi_jb": null,
    "theta_jc": null,
    "Tj_max_C": 125,
    "basis": "SGM2203 DS gives only theta_JA 65 C/W (SOT-89-3)"
   }
  },
  "pads": {}
 }
}