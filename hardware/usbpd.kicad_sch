	)
	(text "SW1, SW2: TS-1088 4 x 3 mm, top-actuated (printed plungers)\nR1/R2 2.2k to 3.3 V: CH552 reset pull-up (140 uA) keeps the bus < 3.7 V (OLED VDD abs max 4 V)\nR12/R13 220R: firmware runs P1.6/P1.7 open drain, no pull-up (P1_MOD_OC=1, P1_DIR_PU=0); the resistors limit a mistake"
		(exclude_from_sim no)
		(at 25.4 251.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3dfb4b09-13a7-5c0d-8c75-3128b101e7eb")
	)
